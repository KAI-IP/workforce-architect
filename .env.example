# §2 사전 준비물 — 실제 값은 .env.local / Vercel env 에 주입 (커밋 금지)
MISO_BASE_URL=https://<your-endpoint>/ext/v1
MISO_ARCHITECT_KEY=
MISO_WORKFLOW_KEY=
ROCKETPUNCH_API_KEY=
# P0 그라운딩: NCS 시드를 권위 데이터로 갱신할 때만 필요(선택). lib/knowledge/scripts/fetch-ncs.ts
# data.go.kr 활용신청: 15128213(NCS 기준정보), 15063879(NCS 관련 정보)
DATA_GO_KR_SERVICE_KEY=
# true 면 모든 /api/* 라우트가 lib/mocks/*.json 을 반환 (데모 백업/개발 초반)
MOCK_MODE=true
